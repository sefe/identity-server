{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Automation blueprint",
  "$defs": {
    "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "value": {
      "maxLength": 800,
      "maxItems": 20,
      "maxProperties": 20,
      "items": { "$ref": "#/$defs/value" },
      "additionalProperties": { "$ref": "#/$defs/value" }
    },    "section": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 20,
      "additionalProperties": { "$ref": "#/$defs/value" }
    },
    "sectionList": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/value" }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "description": "Repository-relative paths that prove the statement they are attached to. A conclusion nobody can trace back to a file in this repository is a guess.",
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "toolchainDecision": {
      "type": "object",
      "required": [
        "detectedStack",
        "ecosystem",
        "language",
        "runtime",
        "testFramework",
        "packages",
        "coverageFit",
        "alternativesRejected",
        "ciRequirements",
        "deviatesFromDetectedStack"
      ],
      "additionalProperties": false,
      "description": "Evidence-based comparison of the chosen technology with existing automation, the product ecosystem and viable alternatives. No language is the mandatory winner; coverage, diagnosis, reproducibility, maintenance and execution costs determine the choice.",
      "properties": {
        "detectedStack": {
          "type": "object",
          "required": ["language", "buildSystem", "evidence"],
          "additionalProperties": false,
          "description": "What the component under test is actually written in, as found in the repository rather than assumed.",
          "properties": {
            "language": { "type": "string", "minLength": 1, "maxLength": 80 },
            "runtime": { "type": "string", "minLength": 1, "maxLength": 80 },
            "buildSystem": { "type": "string", "minLength": 1, "maxLength": 80 },
            "packageManager": { "type": "string", "minLength": 1, "maxLength": 80 },
            "existingTestFrameworks": {
              "type": "array",
              "maxItems": 20,
              "items": { "type": "string", "minLength": 1, "maxLength": 120 }
            },
            "evidence": { "$ref": "#/$defs/evidence" }
          }
        },
        "ecosystem": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "The package ecosystem the dependencies below are resolved from. It has to be one this installation supports, because an unsupported ecosystem cannot be installed, built or run - which is a limit on what can be executed, not a preference about technology."
        },
        "language": { "type": "string", "minLength": 1, "maxLength": 80 },
        "runtime": {
          "type": "object",
          "required": ["name", "version"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 80 },
            "version": { "type": "string", "minLength": 1, "maxLength": 40 }
          }
        },
        "testFramework": { "type": "string", "minLength": 1, "maxLength": 120 },
        "packages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "description": "The direct dependencies this project needs, proposed rather than approved in advance. A version may be a range: the resolver checks each package exists in the configured source, pins it and writes the lock file.",
          "items": {
            "type": "object",
            "required": ["name", "version", "scope", "purpose"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 200 },
              "version": { "type": "string", "minLength": 1, "maxLength": 60 },
              "scope": { "type": "string", "enum": ["dev", "runtime"] },
              "purpose": { "type": "string", "minLength": 1, "maxLength": 400 }
            }
          }
        },
        "reusedConventions": {
          "type": "array",
          "maxItems": 20,
          "description": "Technologies, settings and conventions taken from the repository instead of introduced. Extending what a team already runs costs them nothing to maintain.",
          "items": { "type": "string", "minLength": 1, "maxLength": 400 }
        },
        "coverageFit": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "description": "How this choice meets each capability the programme requires.",
          "items": {
            "type": "object",
            "required": ["capability", "howItIsMet"],
            "additionalProperties": false,
            "properties": {
              "capability": { "type": "string", "minLength": 1, "maxLength": 120 },
              "howItIsMet": { "type": "string", "minLength": 1, "maxLength": 400 }
            }
          }
        },
        "alternativesRejected": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "description": "What else was considered and why it lost. A decision with no alternatives was not a decision.",
          "items": {
            "type": "object",
            "required": ["option", "reason"],
            "additionalProperties": false,
            "properties": {
              "option": { "type": "string", "minLength": 1, "maxLength": 200 },
              "reason": { "type": "string", "minLength": 1, "maxLength": 600 }
            }
          }
        },
        "ciRequirements": {
          "type": "array",
          "maxItems": 20,
          "description": "What a build agent has to provide for this to run - an SDK, a browser download, a package feed.",
          "items": { "type": "string", "minLength": 1, "maxLength": 400 }
        },
        "deviatesFromDetectedStack": {
          "type": "boolean",
          "description": "True when the automation is not written in the technology of the component it tests."
        },
        "deviationReason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200,
          "description": "Required whenever deviatesFromDetectedStack is true. Explain the evidenced comparative advantage and added toolchain costs. The original ecosystem need not be incapable; familiarity, novelty or popularity alone is insufficient."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "deviatesFromDetectedStack": { "const": true } }, "required": ["deviatesFromDetectedStack"] },
          "then": { "required": ["deviationReason"] }
        }
      ]
    },
    "automationProject": {
      "type": "object",
      "required": ["name", "path", "purpose", "toolchain"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Follows the repository's own component naming convention, as stated in the request."
        },
        "path": { "type": "string", "minLength": 1, "maxLength": 200 },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 800 },
        "runsWith": { "type": "string", "minLength": 1, "maxLength": 200 },
        "toolchain": { "$ref": "#/$defs/toolchainDecision" }
      }
    }
  },
  "allOf": [
    { "$ref": "../common/agent-result.schema.json" },
    {
      "properties": {
        "agentId": { "const": "automation-architect" },
        "stageId": { "const": "architecture" },
        "summary": { "$ref": "#/$defs/summary" },
        "assumptions": { "type": "array", "maxItems": 20 },
        "unknowns": { "type": "array", "maxItems": 20 },
        "warnings": { "type": "array", "maxItems": 20 },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "decision": { "$ref": "#/$defs/section" },
            "stack": { "$ref": "#/$defs/section" },
            "automationProjects": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": { "$ref": "#/$defs/automationProject" }
            },
            "platformBoundary": { "$ref": "#/$defs/section" },
            "structure": { "$ref": "#/$defs/section" },
            "testTaxonomy": { "$ref": "#/$defs/section" },
            "apiStrategy": { "$ref": "#/$defs/section" },
            "webSocketStrategy": { "$ref": "#/$defs/section" },
            "uiStrategy": { "$ref": "#/$defs/section" },
            "configuration": { "$ref": "#/$defs/section" },
            "authentication": { "$ref": "#/$defs/section" },
            "dataStrategy": { "$ref": "#/$defs/section" },
            "logging": { "$ref": "#/$defs/section" },
            "reporting": { "$ref": "#/$defs/section" },
            "diagnostics": { "$ref": "#/$defs/section" },
            "ciIntegration": { "$ref": "#/$defs/section" },
            "proposedCommands": { "$ref": "#/$defs/sectionList" },
            "milestones": { "$ref": "#/$defs/sectionList" },
            "decisionTradeoffs": { "$ref": "#/$defs/sectionList" },
            "guardrails": { "$ref": "#/$defs/sectionList" }
          }
        }
      }
    },
    {
      "$comment": "An architect that cannot design something buildable has nothing to put in a blueprint. Demanding one anyway is how a refusal becomes an invented design.",
      "if": {
        "required": ["status"],
        "properties": { "status": { "const": "completed" } }
      },
      "then": {
        "properties": {
          "details": {
            "required": [
              "decision",
              "stack",
              "automationProjects",
              "structure",
              "proposedCommands",
              "milestones"
            ]
          }
        }
      }
    }
  ]
}
