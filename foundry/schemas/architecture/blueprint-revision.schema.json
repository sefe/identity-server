{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Incremental blueprint revision",
  "type": "object",
  "required": ["baseSha256", "summary", "status", "edits", "deferrals", "resolvedDeferrals"],
  "additionalProperties": false,
  "properties": {
    "baseSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "summary": { "$ref": "automation-blueprint.schema.json#/$defs/summary" },
    "status": { "enum": ["completed", "blocked", "failed"] },
    "edits": {
      "type": "array", "maxItems": 60,
      "items": {
        "type": "object", "required": ["path", "value"], "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "pattern": "^/(details/[^/]+|unknowns|warnings|assumptions|evidence)(/.*)?$" },
          "value": {}
        }
      }
    },
    "deferrals": { "$ref": "../common/agent-result.schema.json#/properties/deferrals" },
    "resolvedDeferrals": {
      "type": "array", "maxItems": 200,
      "items": {
        "type": "object", "required": ["item", "resolution", "paths"], "additionalProperties": false,
        "properties": {
          "item": { "type": "string", "minLength": 1 },
          "resolution": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
