{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Justified changes to automation dependencies",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["toolchainId", "name", "version", "scope", "reason", "versionReason", "evidence"],
    "additionalProperties": false,
    "properties": {
      "toolchainId": { "type": "string", "minLength": 1 },
      "name": { "type": "string", "minLength": 1 },
      "version": { "type": "string", "minLength": 1 },
      "scope": { "enum": ["dev", "runtime"] },
      "reason": { "type": "string", "minLength": 1 },
      "versionReason": { "type": "string", "minLength": 1 },
      "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
    }
  }
}
