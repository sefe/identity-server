{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repair instructions",
  "$comment": "What a targeted review rejection asked the next iteration to rewrite, and which plan the rest of the approved set is carried forward from. Written whenever a rejection is repaired file by file rather than by regenerating the whole tree.",
  "type": "object",
  "required": ["carriedFromPlan", "regeneratePaths", "instructions"],
  "properties": {
    "carriedFromPlan": { "type": "string", "minLength": 1 },
    "regeneratePaths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "instructions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["reviewer", "paths", "instruction"],
        "properties": {
          "reviewer": { "type": "string", "minLength": 1 },
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "instruction": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
