{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded observability evidence",
  "type": "object",
  "required": ["schemaVersion", "runId", "collectedAt", "status", "files", "summary", "warnings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "collectedAt": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["completed", "no_action_needed"] },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "kind", "sha256", "bytes", "content", "truncated"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["log", "trace", "metric", "event", "unknown"] },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "content": { "type": "string" },
          "truncated": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": ["fileCount", "totalBytes", "truncatedFileCount"],
      "properties": {
        "fileCount": { "type": "integer", "minimum": 0 },
        "totalBytes": { "type": "integer", "minimum": 0 },
        "truncatedFileCount": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
