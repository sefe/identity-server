{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent failed-build investigation",
  "allOf": [
    { "$ref": "../common/agent-result.schema.json" },
    {
      "type": "object",
      "required": ["findings"],
      "properties": {
        "stageId": { "const": "failure-investigation" },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "sourceRef",
              "signature",
              "example",
              "affectedCount",
              "classification",
              "hypothesis",
              "evidence",
              "confidence",
              "recommendedAction"
            ],
            "properties": {
              "sourceRef": { "type": "string", "minLength": 1 },
              "signature": { "type": "string", "minLength": 1 },
              "example": { "type": "string" },
              "affectedCount": { "type": "integer", "minimum": 1 },
              "classification": {
                "type": "string",
                "enum": [
                  "product_defect",
                  "test_defect",
                  "framework_defect",
                  "infrastructure",
                  "flaky",
                  "requirement_mismatch",
                  "false_positive",
                  "unknown"
                ]
              },
              "hypothesis": { "type": "string", "minLength": 1 },
              "evidence": { "type": "array", "items": { "type": "string" } },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "recommendedAction": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
