{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Failure analysis",
  "allOf": [
    { "$ref": "../common/agent-result.schema.json" },
    {
      "type": "object",
      "required": ["failures"],
      "properties": {
        "agentId": { "const": "failure-analysis" },
        "stageId": { "const": "execution" },
        "failures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "classification",
              "confidence",
              "evidence",
              "explanation",
              "recommendedAction",
              "automatedCorrectionSafe"
            ],
            "properties": {
              "classification": {
                "type": "string",
                "enum": [
                  "product_defect",
                  "automation_defect",
                  "environment_issue",
                  "test_data_issue",
                  "flaky_test",
                  "locator_drift",
                  "requirement_mismatch",
                  "unknown"
                ]
              },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "evidence": { "type": "array", "items": { "type": "string" } },
              "explanation": { "type": "string" },
              "recommendedAction": { "type": "string" },
              "automatedCorrectionSafe": { "type": "boolean" }
            }
          }
        }
      }
    }
  ]
}

