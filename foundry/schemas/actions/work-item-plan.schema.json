{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Azure Boards work item plan",
  "allOf": [
    { "$ref": "../common/agent-result.schema.json" },
    {
      "type": "object",
      "required": ["outcome", "items"],
      "properties": {
        "outcome": { "type": "string", "enum": ["proposed", "no_action_needed", "blocked"] },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["sourceRef", "type", "title", "description", "priority", "tags", "acceptanceCriteria"],
            "properties": {
              "sourceRef": { "type": "string", "minLength": 1 },
              "type": { "type": "string", "enum": ["backlog_item", "bug", "task", "test_case"] },
              "parentRef": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "priority": { "type": "integer", "minimum": 1, "maximum": 4 },
              "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "acceptanceCriteria": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            },
            "if": {
              "properties": { "type": { "const": "task" } },
              "required": ["type"]
            },
            "then": { "required": ["parentRef"] },
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
